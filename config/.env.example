# Copy to backend/.env (or export these in your shell) before running the
# API server. Nothing in this file is a secret by itself -- HOSTED_LLM_API_KEY
# is the one value that should never be committed once filled in.

# --- Generation provider (D6/D9, app/generation/llm_provider.py) -----------
# "ollama"  local, fully offline, ~20-60s/answer on this CPU -- correctness
#           testing, not live demos. Requires `ollama pull qwen2.5:3b-instruct`
#           and `ollama serve` running first.
# "hosted"  any OpenAI-compatible endpoint, ~2-4s/answer -- default fast
#           mode for demos. Sends retrieved policy chunks to that endpoint;
#           see the trade-off note in llm_provider.py's module docstring.
# "vllm"    reserved for the DGX Spark deployment (identical interface).
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434/v1
# gemma3:4b benchmarked at ~10 tok/s on this CPU vs llama3.2:1b's ~21 tok/s --
# the smaller model is faster but unreliable at following this project's
# 8-rule system prompt (citations, never-arithmetic, exact figures,
# bilingual, ambiguity disclosure), which costs more in guard-triggered
# retries than the slower model costs in raw generation time.
OLLAMA_MODEL=gemma3:4b

HOSTED_LLM_BASE_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=

# Kept tight deliberately -- an oversized context window allocates KV cache
# and slows every token on CPU; this corpus never needs more than a few
# hundred tokens of retrieved context. Ollama-only (ignored by other providers).
LLM_NUM_CTX=2048

# --- Retrieval store (app/retrieval/qdrant_local.py) ------------------------
# "local"   on-disk, in-process, no server -- what this project runs today.
#           Only one process may hold the collection open at a time: run
#           `python -m app.ingestion.embed_index` to completion and let it
#           exit before starting the API server.
# "server"  a real Qdrant server (e.g. alongside a DGX Spark deployment).
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
